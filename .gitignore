# needs, so the plugin files are excluded one by one rather than by directory.
/ps4/src/hooks.c
/ps4/src/main.c
/ps4/include/hooks.h
/ps4/include/plugin_config.h
/ps4/build_prx.sh
/docs/DEPLOY-PS4.md

# Downloaded / cloned third-party sources (see scripts/fetch_vendor.sh)
/vendor/

# Locally downloaded toolchains (zig, OpenOrbis release, GoldHEN SDK)
/.tools/

# Build output
/build/
/obj/
/bin/
*.o
*.elf
*.oelf
*.prx

